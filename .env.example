# Environment variables for Preach Pro
# Copy this file to .env.local and fill in your values

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Preach Pro"

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/preach_pro"

# Authentication (if needed)
# NEXTAUTH_SECRET=""
# NEXTAUTH_URL=""

# AI Integration (for sermon writing assistance)
# OPENAI_API_KEY=""
# Or other AI provider keys as needed

# API Keys (if needed)
# NEXT_PUBLIC_API_KEY=""